{
  "manifest_version": 3,
  "name": "ŞİGAL • Modern New Tab",
  "version": "2.3.1",
  "description": "ŞİGAL — motivasyon, görevler, kısayollar ve kişiselleştirme özellikli modern yeni sekme.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "geolocation"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://suggestqueries.google.com/*",
    "https://*.gstatic.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
{
  "manifest_version": 3,
  "name": "ŞİGAL • Web New Tab",
  "version": "3.0.0",
  "description": "ŞİGAL — ultra hızlı ve kesintisiz web tabanlı yeni sekme deneyimi.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "ŞİGAL Yeni Sekme"
  }
}